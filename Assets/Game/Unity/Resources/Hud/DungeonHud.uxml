<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="DungeonHud.uss" />
    <!--
        The dungeon fills the whole screen and this HUD floats on top of it. Anything marked
        picking-mode="Ignore" lets the mouse through to the board; everything else blocks it.
        DungeonHud.cs finds elements by name, so keep the names when restyling or moving things.
    -->
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">

        <ui:VisualElement name="stage-title" class="stage-title" picking-mode="Ignore">
            <ui:Label name="stage-number" class="stage-number shadowed" text="스테이지 1 / 3" picking-mode="Ignore" />
            <ui:Label name="stage-name" class="stage-name shadowed" text="성문으로 가는 길" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="boss-bar" class="boss-bar">
            <ui:VisualElement class="boss-row" picking-mode="Ignore">
                <ui:Label name="boss-tag" class="boss-tag" text="BOSS" picking-mode="Ignore" />
                <ui:Label name="boss-name" class="boss-name" text="무덤 기사" picking-mode="Ignore" />
                <ui:Label name="boss-hp" class="boss-hp" text="64 / 64" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="meter boss-meter" picking-mode="Ignore">
                <ui:VisualElement name="boss-fill" class="meter-fill health" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="pause-banner" class="pause-banner" text="일시정지" picking-mode="Ignore" />

        <!-- Experience and item names float up from the board here; DungeonHud.cs adds and removes the labels. -->
        <ui:VisualElement name="pops" class="pops" picking-mode="Ignore" />

        <!-- Automatic weapon settlement after combat. -->
        <ui:VisualElement name="spoils" class="spoils" picking-mode="Ignore">
            <ui:Label class="spoils-title" text="— 전투 정산 —" picking-mode="Ignore" />
            <ui:VisualElement name="spoils-lines" class="spoils-lines" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="view-buttons" class="view-buttons" picking-mode="Ignore">
            <ui:Button name="follow" class="chip follow" text="따라가기  켬" focusable="false" />
            <ui:Button name="whole" class="chip" text="전체 보기" focusable="false" />
            <ui:Button name="history-open" class="chip" text="기록" focusable="false" />
        </ui:VisualElement>

        <ui:VisualElement name="party" class="party" picking-mode="Ignore">
            <ui:Label name="party-level" class="hero-level" picking-mode="Ignore" />
            <!-- The party's fatigue: one bar with marks at the 지침 and 탈진 thresholds. -->
            <ui:VisualElement name="fatigue" class="fatigue" picking-mode="Ignore">
                <ui:VisualElement class="fatigue-row" picking-mode="Ignore">
                    <ui:Label name="fatigue-stage" class="fatigue-stage" text="피로 · 여유" picking-mode="Ignore" />
                    <ui:Label name="fatigue-effect" class="fatigue-effect" text="" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="fatigue-meter" picking-mode="Ignore">
                    <ui:VisualElement name="fatigue-fill" class="fatigue-fill" picking-mode="Ignore" />
                    <ui:VisualElement name="fatigue-tick-1" class="fatigue-tick" picking-mode="Ignore" />
                    <ui:VisualElement name="fatigue-tick-2" class="fatigue-tick" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hero-0" class="hero-card role-0">
                <ui:Label name="portrait" class="portrait" picking-mode="Ignore">
                    <ui:VisualElement name="face" class="portrait-face" picking-mode="Ignore" />
                </ui:Label>
                <ui:VisualElement class="hero-info" picking-mode="Ignore">
                    <ui:Label name="name" class="hero-name" text="탱커  가론" picking-mode="Ignore" />
                    <ui:VisualElement class="hero-row" picking-mode="Ignore">
                        <ui:Label name="hp" class="hero-hp" text="HP 46 / 46" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meter hero-health" picking-mode="Ignore">
                        <ui:VisualElement name="health" class="meter-fill health" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="kit" class="hero-kit" picking-mode="Ignore">
                    <ui:Label name="weapon" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="armor" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="skill-0" class="kit-slot skill" text="도발" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                    <ui:Label name="skill-1" class="kit-slot skill" text="방패 벽" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="bubble" class="bubble" picking-mode="Ignore">
                    <ui:VisualElement class="bubble-tail" picking-mode="Ignore" />
                    <ui:Label name="line" class="bubble-text" text="내 뒤로 물러서!" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hero-1" class="hero-card role-1">
                <ui:Label name="portrait" class="portrait" picking-mode="Ignore">
                    <ui:VisualElement name="face" class="portrait-face" picking-mode="Ignore" />
                </ui:Label>
                <ui:VisualElement class="hero-info" picking-mode="Ignore">
                    <ui:Label name="name" class="hero-name" text="힐러  세레나" picking-mode="Ignore" />
                    <ui:VisualElement class="hero-row" picking-mode="Ignore">
                        <ui:Label name="hp" class="hero-hp" text="HP 28 / 28" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meter hero-health" picking-mode="Ignore">
                        <ui:VisualElement name="health" class="meter-fill health" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="kit" class="hero-kit" picking-mode="Ignore">
                    <ui:Label name="weapon" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="armor" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="skill-0" class="kit-slot skill" text="도발" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                    <ui:Label name="skill-1" class="kit-slot skill" text="방패 벽" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="bubble" class="bubble" picking-mode="Ignore">
                    <ui:VisualElement class="bubble-tail" picking-mode="Ignore" />
                    <ui:Label name="line" class="bubble-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hero-2" class="hero-card role-2">
                <ui:Label name="portrait" class="portrait" picking-mode="Ignore">
                    <ui:VisualElement name="face" class="portrait-face" picking-mode="Ignore" />
                </ui:Label>
                <ui:VisualElement class="hero-info" picking-mode="Ignore">
                    <ui:Label name="name" class="hero-name" text="근딜  카이" picking-mode="Ignore" />
                    <ui:VisualElement class="hero-row" picking-mode="Ignore">
                        <ui:Label name="hp" class="hero-hp" text="HP 36 / 36" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meter hero-health" picking-mode="Ignore">
                        <ui:VisualElement name="health" class="meter-fill health" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="kit" class="hero-kit" picking-mode="Ignore">
                    <ui:Label name="weapon" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="armor" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="skill-0" class="kit-slot skill" text="도발" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                    <ui:Label name="skill-1" class="kit-slot skill" text="방패 벽" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="bubble" class="bubble" picking-mode="Ignore">
                    <ui:VisualElement class="bubble-tail" picking-mode="Ignore" />
                    <ui:Label name="line" class="bubble-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hero-3" class="hero-card role-3">
                <ui:Label name="portrait" class="portrait" picking-mode="Ignore">
                    <ui:VisualElement name="face" class="portrait-face" picking-mode="Ignore" />
                </ui:Label>
                <ui:VisualElement class="hero-info" picking-mode="Ignore">
                    <ui:Label name="name" class="hero-name" text="원딜  리아" picking-mode="Ignore" />
                    <ui:VisualElement class="hero-row" picking-mode="Ignore">
                        <ui:Label name="hp" class="hero-hp" text="HP 32 / 32" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meter hero-health" picking-mode="Ignore">
                        <ui:VisualElement name="health" class="meter-fill health" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="kit" class="hero-kit" picking-mode="Ignore">
                    <ui:Label name="weapon" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="armor" class="kit-slot gear" text="" picking-mode="Ignore" />
                    <ui:Label name="skill-0" class="kit-slot skill" text="도발" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                    <ui:Label name="skill-1" class="kit-slot skill" text="방패 벽" picking-mode="Ignore">
                        <ui:VisualElement name="cooldown" class="kit-cooldown" picking-mode="Ignore" />
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="bubble" class="bubble" picking-mode="Ignore">
                    <ui:VisualElement class="bubble-tail" picking-mode="Ignore" />
                    <ui:Label name="line" class="bubble-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="ai-mode" class="ai-mode shadowed" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="bottom" class="bottom">
            <ui:VisualElement class="tab-bar">
                <ui:Label name="category" class="tab" text="몬스터 배치" />
                <ui:Label name="hint" class="hint" text="우클릭 드래그 이동 · 휠 확대" />
                <ui:VisualElement class="stats">
                    <ui:Label class="stat-title" text="위협 예산" />
                    <ui:Label name="budget" class="stat-value gold" text="6" />
                    <ui:Label class="stat-title" text="신앙" />
                    <ui:Label name="faith" class="stat-value teal" text="1" />
                </ui:VisualElement>
                <ui:Button name="primary" class="primary" text="원정 출발  ›" focusable="false" />
                <ui:Button name="collapse" class="chip collapse" text="▼" focusable="false" />
            </ui:VisualElement>

            <ui:VisualElement name="content" class="content">
                <ui:VisualElement name="planning" class="page">
                    <ui:Button name="brush-skeleton" class="skill-button placement-button" focusable="false">
                        <ui:VisualElement class="skill-art brush-skeleton-art" picking-mode="Ignore" />
                        <ui:Label class="skill-title" text="해골" picking-mode="Ignore" />
                        <ui:Label class="placement-description" text="근접 · 전방 크게 베기" picking-mode="Ignore" />
                        <ui:Label name="detail" class="placement-cost" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="brush-ghost" class="skill-button placement-button" focusable="false">
                        <ui:VisualElement class="skill-art brush-ghost-art" picking-mode="Ignore" />
                        <ui:Label class="skill-title" text="유령" picking-mode="Ignore" />
                        <ui:Label class="placement-description" text="두 용사 발밑에 쌍묘비" picking-mode="Ignore" />
                        <ui:Label name="detail" class="placement-cost" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="brush-zombie" class="skill-button placement-button" focusable="false">
                        <ui:VisualElement class="skill-art brush-zombie-art" picking-mode="Ignore" />
                        <ui:Label class="skill-title" text="좀비" picking-mode="Ignore" />
                        <ui:Label class="placement-description" text="높은 체력 · 방패 밀치기" picking-mode="Ignore" />
                        <ui:Label name="detail" class="placement-cost" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="brush-archer" class="skill-button placement-button" focusable="false">
                        <ui:VisualElement class="skill-art brush-archer-art" picking-mode="Ignore" />
                        <ui:Label class="skill-title" text="해골 궁수" picking-mode="Ignore" />
                        <ui:Label class="placement-description" text="머리 투척 · 3×3 폭발" picking-mode="Ignore" />
                        <ui:Label name="detail" class="placement-cost" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="brush-remove" class="skill-button placement-button" focusable="false">
                        <ui:VisualElement class="skill-art brush-remove-art" picking-mode="Ignore" />
                        <ui:Label class="skill-title" text="배치 지우기" picking-mode="Ignore" />
                        <ui:Label class="placement-description" text="선택한 칸의 몬스터 제거" picking-mode="Ignore" />
                        <ui:Label name="detail" class="placement-cost" text="비용 환급" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:VisualElement class="summary">
                        <ui:Label name="summary-title" class="summary-title" text="배치한 몬스터 없음" />
                        <ui:Label name="summary-detail" class="summary-detail" text="" />
                        <!-- The stage's fixed features: patrols (their routes are drawn on the floor), chests and springs. -->
                        <ui:Label name="summary-note" class="summary-note" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="speed" class="speed" picking-mode="Ignore">
            <ui:Button name="speed-0" class="chip" text="일시정지" focusable="false" />
            <ui:Button name="speed-1" class="chip" text="1배속" focusable="false" />
            <ui:Button name="speed-2" class="chip" text="2배속" focusable="false" />
        </ui:VisualElement>
        <ui:VisualElement name="intervention" class="skill-dock" picking-mode="Ignore">
            <ui:VisualElement class="faith-meter" picking-mode="Ignore">
                <ui:VisualElement class="faith-icon" picking-mode="Ignore" />
                <ui:Label name="expedition-faith" class="faith-total" picking-mode="Ignore" />
                <ui:VisualElement name="faith-cells" class="faith-cells" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="skill-buttons" picking-mode="Ignore">
                <ui:VisualElement class="skill-slot">
                    <ui:Button name="trial" class="skill-button" focusable="false">
                        <ui:Label class="skill-title" text="낙석 역경" picking-mode="Ignore" />
                        <ui:VisualElement class="skill-art rockfall" picking-mode="Ignore" />
                        <ui:VisualElement class="skill-cost" picking-mode="Ignore">
                            <ui:VisualElement class="faith-icon" picking-mode="Ignore" />
                            <ui:Label name="cost" text="0" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:VisualElement class="skill-description" picking-mode="Ignore">
                        <ui:Label name="trial-detail" picking-mode="Ignore" />
                        <ui:Label text="성공 경험치·신앙 +1" picking-mode="Ignore" />
                        <ui:Label name="trial-risk" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="skill-slot">
                    <ui:Button name="bless" class="skill-button" focusable="false">
                        <ui:Label class="skill-title" text="축복" picking-mode="Ignore" />
                        <ui:VisualElement class="skill-art blessing" picking-mode="Ignore" />
                        <ui:VisualElement class="skill-cost" picking-mode="Ignore">
                            <ui:VisualElement class="faith-icon" picking-mode="Ignore" />
                            <ui:Label name="cost" text="0" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:VisualElement class="skill-description" picking-mode="Ignore">
                        <ui:Label name="bless-detail" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="skill-slot">
                    <ui:Button name="rest" class="skill-button" focusable="false">
                        <ui:Label class="skill-title" text="피로 회복" picking-mode="Ignore" />
                        <ui:VisualElement class="skill-art rest-feather" picking-mode="Ignore" />
                        <ui:VisualElement class="skill-cost" picking-mode="Ignore">
                            <ui:VisualElement class="faith-icon" picking-mode="Ignore" />
                            <ui:Label name="cost" text="0" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:VisualElement class="skill-description" picking-mode="Ignore">
                        <ui:Label name="rest-detail" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="stage-clear" class="stage-clear">
            <ui:Label name="stage-clear-title" class="result-title" />
            <ui:Button name="stage-continue" class="primary" text="다음 스테이지 준비" focusable="false" />
        </ui:VisualElement>

        <ui:VisualElement name="result" class="result">
            <ui:Label name="result-title" class="result-title" text="마왕을 쓰러뜨렸습니다" />
            <ui:Label name="result-text" class="result-text" text="최종 파티 레벨 1" />
            <ui:VisualElement class="result-actions">
                <ui:Button name="result-new" class="primary result-action" text="새 원정" focusable="false" />
                <ui:Button name="result-copy" class="chip result-action" text="편성·배치 복사" focusable="false" />
                <ui:Button name="result-replay" class="chip result-action" text="같은 시드로" focusable="false" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="history" class="history-backdrop">
            <ui:VisualElement class="history-box">
                <ui:VisualElement class="history-head">
                    <ui:Label class="history-title" text="원정 기록" />
                    <ui:Button name="history-close" class="chip history-close" text="닫기" focusable="false" />
                </ui:VisualElement>
                <ui:Label name="history-stats" class="info-text" />
                <ui:ScrollView name="history-list" class="history-list" horizontal-scroller-visibility="Hidden" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
    <ui:VisualElement name="title-screen" class="title-screen">
        <ui:VisualElement class="title-menu">
            <ui:Label text="던전 타이쿤" class="title-name" />
            <ui:Button name="title-new" text="새 게임" class="title-action title-primary" />
            <ui:Button name="title-continue" text="이어하기" class="title-action" />
            <ui:Button name="title-quit" text="게임 종료" class="title-action" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
