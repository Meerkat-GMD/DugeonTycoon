/*
    Fork debate and adversity stage (variant C "무대"). Cloned into the HUD's `hud` element, so the HUD's
    colour variables, font and panel units (about 640 units tall, at least 1000 wide) apply here too.
    Every rule is prefixed with .hud so it wins over the default runtime theme.
*/

.hud .dialogue-stage {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 10px;
    height: 214px;
    display: none;
}

/* ── Dialogue box ────────────────────────────────────────────────── */

.hud .stage-box {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 110px;
    padding: 16px 24px 30px 24px;
    background-color: rgba(21, 27, 32, 0.94);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 8px;
}

.hud .stage-line {
    flex-direction: row;
    align-items: flex-start;
}

.hud .stage-speaker {
    flex-shrink: 0;
    margin-right: 12px;
    font-size: 17px;
    -unity-font-style: bold;
}

.hud .stage-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 17px;
    white-space: normal;
    color: var(--paper);
}

.hud .stage-box.narration .stage-text {
    color: var(--gold);
    -unity-font-style: italic;
    -unity-text-align: upper-center;
}

.hud .stage-next {
    position: absolute;
    right: 128px;
    bottom: 9px;
    font-size: 12px;
    color: var(--gold);
    display: none;
}

.hud .stage-auto {
    position: absolute;
    right: 10px;
    bottom: 7px;
    height: 22px;
    min-width: 0;
    margin: 0;
    padding: 0 10px;
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 11px;
    background-color: var(--ink);
    color: var(--muted);
    font-size: 11px;
}

.hud .stage-auto:hover {
    background-color: var(--card);
}

.hud .stage-auto.on {
    border-color: var(--gold);
    background-color: var(--gold);
    color: var(--ink);
    -unity-font-style: bold;
}

/* ── Portrait slots ──────────────────────────────────────────────── */

.hud .stage-slots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 102px;
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-end;
}

.hud .stage-slot {
    width: 92px;
    align-items: center;
    opacity: 0.55;
    transition-property: translate, scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.hud .stage-slot.thinking {
    opacity: 0.85;
}

.hud .stage-slot.rolling {
    opacity: 1;
}

/* The same profile art as the hero cards: a round frame with the hero's face on top. */
.hud .stage-portrait {
    width: 72px;
    height: 72px;
    border-width: 3px;
    border-radius: 36px;
    border-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/Heroes/Portraits/portrait_frame.png");
    -unity-background-scale-mode: scale-to-fit;
}

.hud .stage-face {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud .stage-slot.role-0 .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_tank.png"); }
.hud .stage-slot.role-1 .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_healer.png"); }
.hud .stage-slot.role-2 .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_melee.png"); }
.hud .stage-slot.role-3 .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_ranged.png"); }

.hud .stage-hero-name {
    margin-top: 3px;
    padding: 0 8px;
    border-radius: 6px;
    background-color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
}

.hud .stage-slot.role-0 .stage-hero-name { color: #74C5C4; }
.hud .stage-slot.role-1 .stage-hero-name { color: #E2C77D; }
.hud .stage-slot.role-2 .stage-hero-name { color: #DB9AA8; }
.hud .stage-slot.role-3 .stage-hero-name { color: #A2CD88; }

/* The speaker steps forward with a gold ring. Kept after the role colours so the ring wins. */
.hud .stage-slot.talk {
    opacity: 1;
    translate: 0 -14px;
    scale: 1.12 1.12;
}

.hud .stage-slot.talk .stage-portrait {
    border-color: var(--gold);
}

.hud .stage-bubble { left: 62px; top: -32px; display: none; }
.hud .stage-slot.talk .stage-bubble { display: flex; }
.hud .stage-slot.down .stage-bubble { display: none; }

.hud .stage-slot.down {
    opacity: 1;
}

.hud .stage-slot.down .stage-portrait {
    -unity-background-image-tint-color: rgba(140, 140, 140, 0.6);
}

.hud .stage-slot.role-0.down .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_tank_down.png"); }
.hud .stage-slot.role-1.down .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_healer_down.png"); }
.hud .stage-slot.role-2.down .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_melee_down.png"); }
.hud .stage-slot.role-3.down .stage-face { background-image: url("/Assets/Art/Heroes/Portraits/portrait_ranged_down.png"); }

.hud .stage-slot.down .stage-hero-name {
    color: #7E8A88;
}

/* "생각 중…" or "쓰러짐" floats just above the portrait. */
.hud .stage-status {
    position: absolute;
    top: -22px;
    left: -24px;
    right: -24px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--gold);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
    display: none;
}

.hud .stage-slot.down .stage-status {
    color: var(--ember);
}

/* "원함", "패스" or "손해" pinned above a portrait during the loot debate; same spot as the status. */
.hud .stage-mark {
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    padding: 1px 8px;
    border-radius: 8px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    display: none;
}

.hud .stage-mark.want {
    background-color: var(--gold);
    color: var(--ink);
}

.hud .stage-mark.pass {
    background-color: #3A464B;
    color: var(--paper);
}

.hud .stage-mark.worse {
    background-color: var(--ember);
    color: var(--ink);
}

.hud .stage-mark.opt {
    background-color: var(--paper);
    color: var(--ink);
}

/* ── The god's die, centred above the slots ──────────────────────── */

.hud .stage-god {
    position: absolute;
    left: 50%;
    bottom: 196px;
    translate: -50% 0;
    padding: 4px 14px;
    align-items: center;
    border-radius: 12px;
    background-color: rgba(229, 185, 78, 0.16);
    display: none;
}

.hud .stage-god-name {
    padding: 0 8px;
    border-radius: 6px;
    background-color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--gold);
}

/* ── Oracle path cards ───────────────────────────────────────────── */

.hud .stage-oracle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 236px;
    align-items: center;
    display: none;
}

.hud .oracle-question {
    margin-bottom: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--gold);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
}

.hud .oracle-cards {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.hud .oracle-card {
    width: 150px;
    margin: 0 6px;
    padding: 6px 10px 8px 10px;
    align-items: center;
    background-color: rgba(18, 23, 26, 0.95);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 8px;
}

.hud .oracle-card:hover {
    border-color: var(--gold);
    translate: 0 -4px;
}

.hud .oracle-card.skip {
    width: 96px;
    opacity: 0.8;
}

.hud .oracle-number {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--gold);
}

.hud .oracle-label {
    margin: 1px 0 4px 0;
    font-size: 16px;
    -unity-font-style: bold;
}

.hud .oracle-backers {
    flex-direction: row;
}

.hud .oracle-face {
    width: 20px;
    height: 20px;
    margin: 0 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud .oracle-face.role-0 { background-image: url("/Assets/Art/Heroes/Portraits/portrait_tank.png"); }
.hud .oracle-face.role-1 { background-image: url("/Assets/Art/Heroes/Portraits/portrait_healer.png"); }
.hud .oracle-face.role-2 { background-image: url("/Assets/Art/Heroes/Portraits/portrait_melee.png"); }
.hud .oracle-face.role-3 { background-image: url("/Assets/Art/Heroes/Portraits/portrait_ranged.png"); }

.hud .oracle-countdown {
    width: 220px;
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.8);
}

.hud .oracle-timer {
    height: 100%;
    width: 100%;
    border-radius: 2px;
    background-color: var(--gold);
}

/* ── The armour on the table, beside the slots ───────────────────── */

.hud .stage-item {
    position: absolute;
    right: -128px;
    bottom: 112px;
    width: 116px;
    padding: 6px 6px 7px 6px;
    align-items: center;
    background-color: rgba(18, 23, 26, 0.95);
    border-width: 2px;
    border-color: var(--muted);
    border-radius: 8px;
    display: none;
}

.hud .stage-item.rare {
    border-color: #9B7BE0;
}

.hud .stage-item-grade {
    font-size: 10px;
    color: var(--muted);
}

.hud .stage-item.rare .stage-item-grade {
    color: #D9C8FF;
}

.hud .stage-item-name {
    margin: 2px 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud .stage-item-stats {
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud .stage-item-power {
    margin-top: 2px;
    font-size: 10px;
    color: var(--muted);
}

/* ── Dice ────────────────────────────────────────────────────────── */

.hud .stage-over {
    position: absolute;
    bottom: 100%;
    left: -40px;
    right: -40px;
    margin-bottom: 4px;
    align-items: center;
}

.hud .stage-die {
    width: 54px;
    height: 54px;
    align-items: center;
    justify-content: center;
}

.hud .stage-die-number {
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink);
}

.hud .stage-die.nat1 .stage-die-number {
    color: #FFD9CF;
}

.hud .stage-die.dim {
    opacity: 0.45;
}

.hud .stage-calc {
    margin-top: 2px;
    font-size: 13px;
    color: var(--paper);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.hud .stage-calc.show {
    opacity: 1;
}

.hud .stage-crown {
    margin-bottom: 3px;
    padding: 1px 8px;
    border-radius: 8px;
    background-color: var(--gold);
    color: var(--ink);
    font-size: 11px;
    -unity-font-style: bold;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.hud .stage-crown.show {
    opacity: 1;
}

/* ── Difficulty and stamp, beside the slots ──────────────────────── */

.hud .stage-dc {
    position: absolute;
    right: -108px;
    bottom: 118px;
    width: 96px;
    align-items: center;
    display: none;
}

.hud .stage-dc-caption {
    font-size: 11px;
    color: var(--muted);
}

.hud .stage-dc-value {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--paper);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
}

.hud .stage-stamp {
    margin-top: 6px;
    padding: 2px 10px;
    border-width: 3px;
    border-radius: 6px;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    rotate: -8deg;
    scale: 2 2;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.hud .stage-stamp.ok {
    color: var(--teal);
    border-color: var(--teal);
}

.hud .stage-stamp.fail {
    color: var(--ember);
    border-color: var(--ember);
}

.hud .stage-stamp.show {
    scale: 1 1;
    opacity: 1;
}
